# Copy this file to .env and fill in real values. NEVER commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wallet_db

# Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

RATE_LIMIT_PER_MINUTE=60
TRANSFER_RATE_LIMIT_PER_MINUTE=10

ALLOWED_ORIGINS=http://localhost:3000
